{
  "manifest_version": 3,
  "name": "AddVoid",
  "version": "1.0.0",
  "description": "Manifest V3 ad-privacy extension with MAIN world shielding and declarative network redirection.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "declarativeNetRequest",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AddVoid",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "void_ruleset",
        "enabled": true,
        "path": "ruleset.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "addvoid@example.com",
      "strict_min_version": "120.0"
    }
  }
}
